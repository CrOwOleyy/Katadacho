{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "katadacho",
  "version": "0.1.0",
  "identifier": "com.katadacho.island",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "island",
        "title": "Katadacho Island",
        "width": 900,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Katadacho",
    "copyright": "Copyright (c) 2026 Katadacho",
    "category": "Utility",
    "shortDescription": "Une Dynamic Island pour le bureau : contrôles, média, presse-papier et lanceur.",
    "longDescription": "Katadacho affiche une île flottante en haut de l'écran : volume, luminosité, Wi-Fi et Bluetooth, média en cours, presse-papier, lanceur d'applications, minuteur Pomodoro et notifications.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["pulseaudio-utils | pipewire-pulse", "network-manager", "bluez", "pkexec | policykit-1", "libgtk-layer-shell0"]
      },
      "rpm": {
        "depends": ["pulseaudio-utils", "NetworkManager", "bluez", "polkit", "gtk-layer-shell"]
      }
    }
  }
}
